# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# Temporary files generated by your text editor or operating system
# belong in git's global ignore instead:
# `$XDG_CONFIG_HOME/git/ignore` or `~/.config/git/ignore`

# Ignore bundler config.
/.bundle

# Ignore all environment files.
/.env*

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

# Ignore storage (uploaded files in development and any SQLite databases).
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep

/public/assets

# Ignore master key for decrypting credentials and more.
/config/master.key

# Bundler install path (.bundle/config BUNDLE_PATH)
/vendor/bundle

# Editor / local tool state
/.ruby-lsp
/.claude/settings.local.json

# 取得したデータは個人利用に限り、公開・共有しない（docs/design.md「求人の取得元」）
/samples/
/spec/fixtures/files/paiza/
# 古いスクリプトと取得済みHTML。規約でスクレイピングを禁止しているサイト（Geekly）向けのスクリプトを含むため公開しない
/legacy/

# 実在の求人ページを使うテスト（実在の求人の内容を含むため公開しない）
/spec/local/
